# -------------------------------------------------------
# Site Web Monitor - Environment Configuration
# -------------------------------------------------------
# Copy this file to .env and fill in the values.
# NEVER commit the actual .env file to version control.
# -------------------------------------------------------

# Monitoring interval in seconds (default: 300 = 5 minutes)
CHECK_INTERVAL_SECONDS=300

# Telegram Bot API credentials
# Create a bot via @BotFather and get the token.
# Get your chat ID via @userinfobot or similar.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Target website URLs
TARGET_LOGIN_URL=https://mobile-tracker-free.com/login/
TARGET_DASHBOARD_URL=https://mobile-tracker-free.com/dashboard/

# Private directory for auth state and runtime data.
# On production (Oracle VM), use: /opt/site-web-monitor-private
# On local dev, leave empty to use data/ inside the project.
# PRIVATE_DIR=/opt/site-web-monitor-private

# Maximum retry attempts for transient failures
MAX_RETRIES=4
